    <Compile Include="../../tools/DotJpegli.Parity/PpmImage.cs" Link="PpmImage.cs" />
    <Compile Include="../../tools/DotJpegli.Automation/Arguments.cs" Link="Automation/Arguments.cs" />
    <Compile Include="../../tools/DotJpegli.Automation/CliReleaseCommand.cs" Link="Automation/CliReleaseCommand.cs" />
    <Compile Include="../../tools/DotJpegli.Automation/CliReleaseTests.cs" Link="Automation/CliReleaseTests.cs" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
</Project>
