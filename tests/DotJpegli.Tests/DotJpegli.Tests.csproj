<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Keep compatibility runs separate from the normal runtime-specific build. -->
    <OutputPath Condition="'$(DotJpegliLibraryTargetFramework)' != ''">bin/$(Configuration)/$(DotJpegliLibraryTargetFramework)/</OutputPath>
    <IntermediateOutputPath Condition="'$(DotJpegliLibraryTargetFramework)' != ''">obj/$(Configuration)/$(DotJpegliLibraryTargetFramework)/</IntermediateOutputPath>
    <DefineConstants Condition="'$(DotJpegliLibraryTargetFramework)' == 'netstandard2.1'">$(DefineConstants);DOTJPEGLI_NETSTANDARD_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotJpegli/DotJpegli.csproj">
      <SetTargetFramework Condition="'$(DotJpegliLibraryTargetFramework)' != ''">TargetFramework=$(DotJpegliLibraryTargetFramework)</SetTargetFramework>
    </ProjectReference>
    <PackageReference Include="xunit.v3" />
    <!-- Independent decoder used only in tests; the encoder has no package dependencies. -->
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(DotJpegliLibraryTargetFramework)' == 'netstandard2.1'">
    <!-- Intrinsic-only internal helpers do not exist in the portable assembly. -->
    <Compile Remove="Net11DctTransposeTests.cs;Net11DownsamplingTests.cs;FusedPlaneQuantizationTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../tools/DotJpegli.Parity/ProgressiveScanSearch.cs" Link="Parity/ProgressiveScanSearch.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/ProgressiveScanSearchCommand.cs" Link="Parity/ProgressiveScanSearchCommand.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/JpegStructure.cs" Link="Parity/JpegStructure.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/PpmImage.cs" Link="Parity/PpmImage.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/QuantizationTableSearch.cs" Link="Parity/QuantizationTableSearch.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/QuantizationTableSearchCommand.cs" Link="Parity/QuantizationTableSearchCommand.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/QualityMetrics.cs" Link="Parity/QualityMetrics.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/RateDistortion.cs" Link="Parity/RateDistortion.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/RateDistortionSearch.cs" Link="Parity/RateDistortionSearch.cs" />
    <Compile Include="../../tools/DotJpegli.Parity/RateDistortionSearchCommand.cs" Link="Parity/RateDistortionSearchCommand.cs" />
  </ItemGroup>
</Project>
