[*.cs]
# Keep test vectors beside their assertions and avoid sharing mutable arrays between tests.
dotnet_diagnostic.CA1861.severity = none

# Fixed seeds make generated regression fixtures reproducible; no security tokens are generated here.
dotnet_diagnostic.CA5394.severity = none

# xUnit generates a synchronous Main that bridges its asynchronous runners.
# Keep this exception limited to the generated entry point, not test source.
[XunitAutoGeneratedEntryPoint.cs]
dotnet_diagnostic.RS0030.severity = none
