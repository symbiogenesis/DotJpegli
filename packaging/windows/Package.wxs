<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DotJpegli CLI ($(var.Architecture))"
           Manufacturer="Edward Miller"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perUser"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DotJpegli CLI is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPCOMMENTS" Value="Native JPEG encoder. No .NET installation is required." />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/symbiogenesis/DotJpegli" />
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="DotJpegliFolder" Name="DotJpegli">
          <Directory Id="INSTALLFOLDER" Name="$(var.Architecture)">
            <Component Id="CliFiles" Guid="$(var.ComponentCode)">
              <!-- HKCU is the component key path for this per-user installation. -->
              <RegistryValue Root="HKCU" Key="Software\DotJpegli\CLI\$(var.Architecture)"
                             Name="Installed" Type="integer" Value="1" KeyPath="yes" />
              <File Id="CliExecutable" Source="$(var.PayloadDirectory)/dotjpegli.exe" />
              <File Source="$(var.PayloadDirectory)/LICENSE" />
              <File Source="$(var.PayloadDirectory)/LICENSE.jpegli" />
              <File Source="$(var.PayloadDirectory)/THIRD-PARTY-NOTICES.md" />
              <File Source="$(var.PayloadDirectory)/LICENSE.dotnet.txt" />
              <File Source="$(var.PayloadDirectory)/THIRD-PARTY-NOTICES.dotnet.txt" />
              <File Source="$(var.PayloadDirectory)/README.md" />
              <Environment Id="CliPath" Name="PATH" Value="[INSTALLFOLDER]"
                           Action="set" Part="last" System="no" Permanent="no" />
              <RemoveFolder Id="RemoveCliFolder" Directory="INSTALLFOLDER" On="uninstall" />
              <RemoveFolder Id="RemoveDotJpegliFolder" Directory="DotJpegliFolder" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Cli" Title="DotJpegli CLI" Level="1">
      <ComponentRef Id="CliFiles" />
    </Feature>
  </Package>
</Wix>
