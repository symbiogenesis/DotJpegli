<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
    <Description>Safe, portable managed JPEG encoder based on Google's Jpegli, compatible with trimming and NativeAOT.</Description>
    <Version>1.0.0</Version>
    <Authors>Edward Miller</Authors>
    <Copyright>Copyright (c) 2026 Edward Miller. Copyright (c) the JPEG XL Project Authors.</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/symbiogenesis/DotJpegli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Consumer publish properties also reach every target during restore. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotJpegli.Tests" />
    <None Include="../../LICENSE;../../LICENSE.jpegli;../../THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Keep GitHub's centered header, but omit its HTML wrapper on NuGet. -->
  <Target Name="GenerateNuGetReadme" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_NuGetReadmePath>$(IntermediateOutputPath)nuget/README.md</_NuGetReadmePath>
      <_NuGetReadmeContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</_NuGetReadmeContent>
      <_NuGetReadmeContent>$([System.Text.RegularExpressions.Regex]::Replace('$(_NuGetReadmeContent)', '(?m)^&lt;(?:div align="center"|/div)&gt;\r?\n(?:\r?\n)?', ''))</_NuGetReadmeContent>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)nuget" />
    <WriteLinesToFile File="$(_NuGetReadmePath)" Lines="$([MSBuild]::Escape($(_NuGetReadmeContent)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_NuGetReadmePath)" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
