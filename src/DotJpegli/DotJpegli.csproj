<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
    <Description>Safe, portable managed JPEG encoder based on Google's Jpegli, compatible with trimming and NativeAOT.</Description>
    <Version>2.0.0</Version>
    <Authors>Edward Miller</Authors>
    <Copyright>Copyright (c) 2026 Edward Miller. Copyright (c) the JPEG XL Project Authors.</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/symbiogenesis/DotJpegli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <!-- Isolated CI comparisons retain both schedules without adding dispatch
         branches to ordinary encodes. Defaults need same-host evidence to change. -->
    <DotJpegliSparseTransposedQuantization Condition="'$(DotJpegliSparseTransposedQuantization)' == ''">false</DotJpegliSparseTransposedQuantization>
    <DotJpegliFullWidthTranspose Condition="'$(DotJpegliFullWidthTranspose)' == ''">false</DotJpegliFullWidthTranspose>
    <DefineConstants Condition="'$(DotJpegliSparseTransposedQuantization)' == 'true'">$(DefineConstants);DOTJPEGLI_SPARSE_TRANSPOSED_QUANTIZATION</DefineConstants>
    <DefineConstants Condition="'$(DotJpegliFullWidthTranspose)' == 'true'">$(DefineConstants);DOTJPEGLI_FULL_WIDTH_TRANSPOSE</DefineConstants>
  </PropertyGroup>

  <!-- Consumer publish properties also reach every target during restore. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotJpegli.Tests" />
    <InternalsVisibleTo Include="DotJpegli.Performance" />
    <InternalsVisibleTo Include="DotJpegli.Parity" />
    <None Include="../../LICENSE;../../LICENSE.jpegli;../../THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- NuGet needs absolute asset/document URLs and does not render the centered wrapper. -->
  <Target Name="GenerateNuGetReadme" BeforeTargets="_GetPackageFiles" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_NuGetReadmePath>$(IntermediateOutputPath)nuget/README.md</_NuGetReadmePath>
      <_NuGetReadmeRevision>$(RepositoryCommit)</_NuGetReadmeRevision>
      <_NuGetReadmeRevision Condition="'$(_NuGetReadmeRevision)' == ''">$(SourceRevisionId)</_NuGetReadmeRevision>
      <_NuGetReadmeRevision Condition="'$(_NuGetReadmeRevision)' == ''">main</_NuGetReadmeRevision>
      <_NuGetReadmeContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../README.md'))</_NuGetReadmeContent>
      <_NuGetReadmeContent>$([System.Text.RegularExpressions.Regex]::Replace('$(_NuGetReadmeContent)', '(?m)^&lt;(?:div align="center"|/div)&gt;\r?\n(?:\r?\n)?', ''))</_NuGetReadmeContent>
      <_NuGetReadmeContent>$([System.Text.RegularExpressions.Regex]::Replace('$(_NuGetReadmeContent)', '(!\[[^\]]*\]\()(?=docs/)', '${1}https://raw.githubusercontent.com/symbiogenesis/DotJpegli/$(_NuGetReadmeRevision)/'))</_NuGetReadmeContent>
      <_NuGetReadmeContent>$([System.Text.RegularExpressions.Regex]::Replace('$(_NuGetReadmeContent)', '(?&lt;!!)(\[[^\]]*\]\()(?=docs/)', '${1}https://github.com/symbiogenesis/DotJpegli/blob/$(_NuGetReadmeRevision)/'))</_NuGetReadmeContent>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)nuget" />
    <WriteLinesToFile File="$(_NuGetReadmePath)" Lines="$([MSBuild]::Escape($(_NuGetReadmeContent)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_NuGetReadmePath)" Pack="true" PackagePath="" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
