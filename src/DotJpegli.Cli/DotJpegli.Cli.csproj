<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep the managed identity distinct from DotJpegli on case-insensitive filesystems. -->
    <AssemblyName>DotJpegli.Cli</AssemblyName>
    <RootNamespace>DotJpegli.Cli</RootNamespace>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../DotJpegli/DotJpegli.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <Description>Encode images as JPEG with DotJpegli.</Description>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Native compiler/runtime packs vary by RID, as in the existing AOT smoke project. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DotJpegli/DotJpegli.csproj" />
    <Compile Include="../../tools/DotJpegli.Parity/PpmImage.cs" Link="PpmImage.cs" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="StbImageSharp" />
    <None Include="../../LICENSE;../../LICENSE.jpegli;../../THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="NamePublicNativeExecutable" AfterTargets="CopyNativeBinary" Condition="'$(PublishAot)' == 'true'">
    <Move SourceFiles="$(PublishDir)$(AssemblyName)$(NativeBinaryExt)" DestinationFiles="$(PublishDir)dotjpegli$(NativeBinaryExt)" />
    <ItemGroup>
      <_CliRuntimePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" DestinationFiles="$(PublishDir)LICENSE.dotnet.txt" />
    <Copy SourceFiles="$(RuntimePackagePath)/THIRD-PARTY-NOTICES.TXT" DestinationFiles="$(PublishDir)THIRD-PARTY-NOTICES.dotnet.txt" />
  </Target>
  <Target Name="NamePublicNativeSymbols" AfterTargets="_CopyAotSymbols" Condition="'$(PublishAot)' == 'true' and Exists('$(PublishDir)$(AssemblyName).pdb')">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).pdb" DestinationFiles="$(PublishDir)dotjpegli.pdb" />
  </Target>
</Project>
