<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Optimize each method at its first JIT compilation; avoid timed tier transitions. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotJpegli/DotJpegli.csproj" />
    <Compile Include="../DotJpegli.Parity/PpmImage.cs" Link="Shared/PpmImage.cs" />
    <Compile Include="../DotJpegli.Parity/ControlledCorpus.cs" Link="Shared/ControlledCorpus.cs" />
    <Compile Include="../DotJpegli.Parity/JpegStructure.cs" Link="Shared/JpegStructure.cs" />
    <None Include="../parity/corpus.json" Link="corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
